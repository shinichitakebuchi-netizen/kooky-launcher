<?xml version="1.0" encoding="utf-8"?>
<!-- ダイアログ：藍の地に利休鼠の細い枠（影・大きな角丸なし） -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp"
    android:insetTop="20dp" android:insetBottom="20dp">
    <shape android:shape="rectangle">
        <solid android:color="#264348" />
        <stroke android:width="1dp" android:color="#656255" />
        <corners android:radius="2dp" />
    </shape>
</inset>
